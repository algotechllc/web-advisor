# Public branding (safe to expose in the browser). Copy to web/.env and fill in.
# On Vercel, set the same keys as project Environment Variables.

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=Web Advisor
NUXT_PUBLIC_SITE_DESCRIPTION=Web Advisor scans public websites for security headers, TLS, DNSSEC, DNS hygiene, Open Graph SEO previews, and Is Agentic readiness, then returns a letter grade and an AI fix prompt.

NUXT_PUBLIC_ORG_NAME=Your Organization
NUXT_PUBLIC_ORG_EMAIL=contact@example.com
NUXT_PUBLIC_ORG_URL=https://example.com
NUXT_PUBLIC_ORG_ADDRESS=Your street, City, Country

# Structured address for Organization JSON-LD
NUXT_PUBLIC_ORG_STREET_ADDRESS=Your street
NUXT_PUBLIC_ORG_LOCALITY=City
NUXT_PUBLIC_ORG_COUNTRY=US
NUXT_PUBLIC_ORG_POSTAL_CODE=00000

NUXT_PUBLIC_GITHUB_URL=https://github.com/algotechllc/web-advisor
